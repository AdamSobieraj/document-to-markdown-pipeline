# ==============================================================================
# 1. USTAWIENIA MINIO / S3
# ==============================================================================
S3_ENDPOINT=http://localhost:9000
AWS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# Optional S3-specific override when the AWS CA bundle should differ.
# S3_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
S3_AKID=minioadmin
S3_SK=minioadmin
S3_REGION=us-east-1
S3_BUCKET=test-bucket

# ==============================================================================
# 2. Custom Overrides
# ==============================================================================
DEFAULT_HEADERS={"None": "None"}

# ==============================================================================
# 3. CZAT (LM STUDIO - AGENT)
# ==============================================================================
LLM_PROVIDER=local
LLM_API_KEY=lm-studio
LLM_BASE_URL=http://192.168.50.112:1234/v1
LLM_MODEL=gemma-4-31b

# ==============================================================================
# 4. CODE PARAMS
# ==============================================================================
VALID_FILE_EXTENSIONS=.pdf,.docx,.doc,.txt,.md,.html,.htm,.pptx,.ppt,.xlsx,.xls,.csv,.json,.xml

# ==============================================================================
# 5. PRE-FLIGHT VALIDATION
# ==============================================================================
PDF_MAGIC=%PDF
ZIP_LOCAL_HEADER=504b0304
MAX_TEXT_SAMPLE_BYTES=8192
FORMAT_CHECKS=pdf=.pdf;zip=.docx,.xlsx,.pptx;text=.md,.txt,.xml,.xsd,.json
